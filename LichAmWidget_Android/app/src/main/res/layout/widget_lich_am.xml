                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- FORECAST ROW: 5-Day Forecast -->
    <LinearLayout
        android:id="@+id/layout_forecast_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_fc_day_0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="H.NAY"
                android:textColor="#787670"
                android:textSize="9sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/iv_fc_icon_0"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_w3d_cloudy_f0" />

            <TextView
                android:id="@+id/tv_fc_temp_0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="18°/23°"
                android:textColor="#3A3D40"
                android:textSize="10sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_fc_day_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="THỨ 4"
                android:textColor="#787670"
                android:textSize="9sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/iv_fc_icon_1"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_w3d_cloudy_f0" />

            <TextView
                android:id="@+id/tv_fc_temp_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="18°/23°"
                android:textColor="#3A3D40"
                android:textSize="10sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_fc_day_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="THỨ 5"
                android:textColor="#787670"
                android:textSize="9sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/iv_fc_icon_2"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_w3d_cloudy_f0" />

            <TextView
                android:id="@+id/tv_fc_temp_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="18°/23°"
                android:textColor="#3A3D40"
                android:textSize="10sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_fc_day_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="THỨ 6"
                android:textColor="#787670"
                android:textSize="9sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/iv_fc_icon_3"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_w3d_cloudy_f0" />

            <TextView
                android:id="@+id/tv_fc_temp_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="18°/23°"
                android:textColor="#3A3D40"
                android:textSize="10sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_fc_day_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="THỨ 7"
                android:textColor="#787670"
                android:textSize="9sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/iv_fc_icon_4"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_w3d_cloudy_f0" />

            <TextView
                android:id="@+id/tv_fc_temp_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="18°/23°"
                android:textColor="#3A3D40"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ALMANAC, LUNAR HOLIDAY & DAILY PROVERB FOOTER -->
    <LinearLayout
        android:id="@+id/layout_almanac_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_widget_almanac"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="☀ Hoàng Đạo • Trực Nguy • Mùng 1 T11 (10ng)"
            android:textColor="#2E7D32"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_widget_proverb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:text="“Có công mài sắt, có ngày nên kim.”"
            android:textColor="#5A5852"
            android:textSize="10sp"
            android:textStyle="italic" />
    </LinearLayout>

</LinearLayout>
