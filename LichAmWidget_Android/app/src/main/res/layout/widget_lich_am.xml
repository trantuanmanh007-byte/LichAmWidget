        </LinearLayout>
        <LinearLayout
            android:id="@+id/col_day_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="3dp"
            android:paddingBottom="3dp">

            <TextView
                android:id="@+id/tv_dow_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="T5"
                android:textColor="#787670"
                android:textSize="9.5sp" />

            <TextView
                android:id="@+id/tv_solar_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="26"
                android:textColor="#1E2328"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_lunar_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="18"
                android:textColor="#8A8882"
                android:textSize="9sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/col_day_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="3dp"
            android:paddingBottom="3dp">

            <TextView
                android:id="@+id/tv_dow_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="T6"
                android:textColor="#787670"
                android:textSize="9.5sp" />

            <TextView
                android:id="@+id/tv_solar_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="27"
                android:textColor="#1E2328"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_lunar_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="19"
                android:textColor="#8A8882"
                android:textSize="9sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/col_day_5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="3dp"
            android:paddingBottom="3dp">

            <TextView
                android:id="@+id/tv_dow_5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="T7"
                android:textColor="#787670"
                android:textSize="9.5sp" />

            <TextView
                android:id="@+id/tv_solar_5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="28"
                android:textColor="#1E2328"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_lunar_5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="20"
                android:textColor="#8A8882"
                android:textSize="9sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/col_day_6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="3dp"
            android:paddingBottom="3dp">

            <TextView
                android:id="@+id/tv_dow_6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CN"
                android:textColor="#787670"
                android:textSize="9.5sp" />

            <TextView
                android:id="@+id/tv_solar_6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="29"
                android:textColor="#1E2328"
                android:textSize="13.5sp"
