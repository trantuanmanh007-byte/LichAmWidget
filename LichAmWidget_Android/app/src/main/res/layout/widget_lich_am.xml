<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_transparent"
    android:orientation="vertical"
    android:paddingLeft="14dp"
    android:paddingTop="6dp"
    android:paddingRight="14dp"
    android:paddingBottom="4dp">

    <!-- TOP ROW: Clock/Date Left + Animated Weather/Battery Right -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- TOP LEFT CLUSTER -->
        <LinearLayout
            android:id="@+id/layout_top_left"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.02"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_greeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chào buổi sáng"
                android:textColor="#6B6A66"
                android:textSize="11.5sp" />

            <TextClock
                android:id="@+id/clock_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="HH:mm"
                android:format24Hour="HH:mm"
                android:includeFontPadding="false"
                android:textColor="#E53935"
                android:textSize="40sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_solar_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Thứ Bảy, 28 Thg 11"
                android:textColor="#3A3D40"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_lunar_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_lunar_pill"
                android:paddingLeft="9dp"
                android:paddingTop="2.5dp"
                android:paddingRight="9dp"
                android:paddingBottom="2.5dp"
                android:text="20/10 ÂL • Bính Ngọ"
                android:textColor="#FFFFFF"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- TOP RIGHT CLUSTER -->
        <LinearLayout
            android:id="@+id/layout_top_right"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.15"
            android:gravity="end"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ViewFlipper
                    android:id="@+id/vf_weather_now"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_marginEnd="4dp"
                    android:autoStart="true"
                    android:flipInterval="220">

                    <ImageView
                        android:id="@+id/iv_weather_f0"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_w3d_rain_f0" />
                    <ImageView
                        android:id="@+id/iv_weather_f1"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_w3d_rain_f1" />
                    <ImageView
                        android:id="@+id/iv_weather_f2"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_w3d_rain_f2" />
                    <ImageView
                        android:id="@+id/iv_weather_f3"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_w3d_rain_f3" />
                    <ImageView
                        android:id="@+id/iv_weather_f4"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_w3d_rain_f4" />
                    <ImageView
                        android:id="@+id/iv_weather_f5"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_w3d_rain_f5" />
                </ViewFlipper>

                <TextView
                    android:id="@+id/tv_temp_now"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="19°"
                    android:textColor="#1E2328"
                    android:textSize="34sp"
                    android:textStyle="normal" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_weather_cond"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Có mưa"
                android:textColor="#3A3D40"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:layout_marginEnd="3dp"
                    android:src="@drawable/ic_pin_red" />

                <TextView
                    android:id="@+id/tv_loc_range"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Hưng Yên • ↑23° ↓18°"
                    android:textColor="#6B6A66"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:background="@drawable/bg_battery_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="8dp"
                android:paddingTop="2.5dp"
                android:paddingRight="8dp"
                android:paddingBottom="2.5dp">

                <ImageView
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:layout_marginEnd="4dp"
                    android:src="@drawable/ic_battery_green" />

                <TextView
                    android:id="@+id/tv_battery"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="82% • 34.0°C"
                    android:textColor="#3B7A57"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- MIDDLE ROW: 7-Day Week Strip -->
    <LinearLayout
