    <!-- RICH ALMANAC, LUNAR HOLIDAY & DAILY PROVERB FOOTER -->
    <LinearLayout
        android:id="@+id/layout_almanac_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:background="@drawable/bg_almanac_strip"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingLeft="8dp"
        android:paddingTop="5dp"
        android:paddingRight="8dp"
        android:paddingBottom="5dp">

        <TextView
            android:id="@+id/tv_widget_almanac"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="☀ HOÀNG ĐẠO (Thanh Long) • Trực Thành • Sao Tất (Tốt)"
            android:textColor="#1B5E20"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_widget_almanac_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1.5dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:text="Ngày Bính Ngọ (Thiên Hà Thủy) • Tiết Tiểu Tuyết • Hỷ: Tây Nam, Tài: Chính Đông"
            android:textColor="#2A2E33"
            android:textSize="9.6sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_widget_almanac_hours"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1.5dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:text="Giờ tốt: Tý(23-1), Sửu(1-3), Mão(5-7), Ngọ(11-13), Thân(15-17), Dậu(17-19)"
            android:textColor="#1E5631"
            android:textSize="9.5sp" />

        <TextView
            android:id="@+id/tv_widget_almanac_advice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1.5dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:text="Nên: Khai trương, cưới hỏi, ký kết • Kỵ: Kiện tụng, tranh chấp"
            android:textColor="#2C3034"
            android:textSize="9.5sp" />

        <!-- UPCOMING LUNAR HOLIDAYS & RẰM / MÙNG 1 BLOCK -->
        <LinearLayout
            android:id="@+id/layout_widget_holidays"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="0.8dp"
                android:background="#DFD7C2" />

            <TextView
                android:id="@+id/tv_widget_holidays_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center"
                android:text="★ Ngày lễ Âm lịch &amp; Rằm / Mùng 1 sắp tới"
                android:textColor="#B71C1C"
                android:textSize="9.8sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2.5dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/col_widget_hol_0"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingEnd="4dp">

                    <TextView
                        android:id="@+id/tv_widget_hol_name_0"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="2"
                        android:text="• Mùng 1 tháng 11 ÂL (1/11 ÂL)"
                        android:textColor="#1E2328"
                        android:textSize="9.2sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_widget_hol_date_0"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="2"
                        android:text="Dương lịch: 09/12/2026 - còn 11 ngày"
