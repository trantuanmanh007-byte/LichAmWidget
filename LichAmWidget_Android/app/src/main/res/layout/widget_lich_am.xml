                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="23"
                android:textColor="#1E2328"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_lunar_0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="15"
                android:textColor="#8A8882"
                android:textSize="9sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/col_day_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="3dp"
            android:paddingBottom="3dp">

            <TextView
                android:id="@+id/tv_dow_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="T3"
                android:textColor="#787670"
                android:textSize="9.5sp" />

            <TextView
                android:id="@+id/tv_solar_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="24"
                android:textColor="#1E2328"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_lunar_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="16"
                android:textColor="#8A8882"
                android:textSize="9sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/col_day_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="3dp"
            android:paddingBottom="3dp">

            <TextView
                android:id="@+id/tv_dow_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="T4"
                android:textColor="#787670"
                android:textSize="9.5sp" />

            <TextView
                android:id="@+id/tv_solar_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="25"
                android:textColor="#1E2328"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_lunar_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="17"
                android:textColor="#8A8882"
